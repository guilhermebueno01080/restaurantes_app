<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/restaurante_fundo" />

    <!-- Escurece a foto para o texto ficar legível -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/sombra_fundo" />

    <ScrollView
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="@string/titulo"
                android:textAllCaps="true"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/pode_entrar_tx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/status_pode_entrar"
                android:textColor="@color/status_livre"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/contador_tx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="96sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/ocupacao_tx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario"
                android:textSize="16sp"
                tools:text="20 lugares livres" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progresso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:maxWidth="320dp"
                app:indicatorColor="@color/status_livre"
                app:trackColor="@color/trilha_progresso"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="480dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sair_bt"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/sair"
                    android:textColor="@color/botao_sair_texto"
                    android:textSize="18sp"
                    app:icon="@drawable/ic_remover"
                    app:iconGravity="textStart"
                    app:iconTint="@color/botao_sair_texto"
                    app:strokeColor="@color/botao_sair_texto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/entrar_bt"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/botao_entrar_fundo"
                    android:text="@string/entrar"
                    android:textColor="@color/botao_entrar_texto"
                    android:textSize="18sp"
                    app:icon="@drawable/ic_adicionar"
                    app:iconGravity="textStart"
                    app:iconTint="@color/botao_entrar_texto" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
